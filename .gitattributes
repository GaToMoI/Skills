# Normalise line endings: LF in the repository, LF in the working tree.
# This repo is documentation + PowerShell/Lua/KDL templates; none of them need CRLF.
* text=auto eol=lf

# Batch files must stay CRLF if any are ever added.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.ico binary
*.zip binary
